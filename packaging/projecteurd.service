[Unit]
Description=Logitech Spotlight daemon (projecteurd)
Documentation=https://github.com/mamrehn/ProjecteurUbuntu
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/projecteurd
Restart=on-failure
RestartSec=3

# No namespaces here (Ubuntu restricts them for unprivileged users); these are enforced by seccomp and the kernel.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
# Only the system calls of an ordinary service (systemd's @system-service set), without the privileged and resource
# control ones. All 83 that the daemon was seen to make (traced through the test suite: devices, D-Bus, discovery)
# are in what is left. Anything else fails with EPERM instead of killing the daemon.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=graphical-session.target
