#!/bin/sh
# SPDX-License-Identifier: MIT
# Turn the Spotlight support on or off for the current user.
#
#   projecteur-setup enable    start projecteurd now and at every login, enable the GNOME Shell extension
#   projecteur-setup disable   the opposite
#   projecteur-setup status
set -eu

UUID="projecteur-overlay@mamrehn.github.io"
SERVICE="projecteurd.service"

say() { printf '%s\n' "$*"; }

extension_listed() { gnome-extensions list 2>/dev/null | grep -qx "$UUID"; }

# Put the extension into the list of enabled extensions directly. gnome-extensions refuses an extension that the
# running shell has not seen yet (on Wayland that is until the next login).
add_to_enabled_list() {
    python3 - "$UUID" <<'PY'
import ast, subprocess, sys
uuid = sys.argv[1]
current = subprocess.run(['gsettings', 'get', 'org.gnome.shell', 'enabled-extensions'], capture_output=True, text=True, check=True).stdout.strip()
items = ast.literal_eval(current.replace('@as ', ''))
if uuid not in items:
    items.append(uuid)
    subprocess.run(['gsettings', 'set', 'org.gnome.shell', 'enabled-extensions', str(items)], check=True)
PY
}

remove_from_enabled_list() {
    python3 - "$UUID" <<'PY'
import ast, subprocess, sys
uuid = sys.argv[1]
current = subprocess.run(['gsettings', 'get', 'org.gnome.shell', 'enabled-extensions'], capture_output=True, text=True, check=True).stdout.strip()
items = [i for i in ast.literal_eval(current.replace('@as ', '')) if i != uuid]
subprocess.run(['gsettings', 'set', 'org.gnome.shell', 'enabled-extensions', str(items)], check=True)
PY
}

case "${1:-}" in
enable)
    systemctl --user enable --now "$SERVICE"
    say "Started $SERVICE (and it starts at every login)."
    if extension_listed; then
        gnome-extensions enable "$UUID"
        say "Enabled the GNOME Shell extension."
    else
        add_to_enabled_list
        say "The GNOME Shell extension is installed. GNOME Shell on Wayland only sees a new extension after you log out and in again; it will be on then."
    fi
    say "Settings: open the Extensions app and choose 'Projecteur Overlay', or run: gnome-extensions prefs $UUID"
    ;;
disable)
    gnome-extensions disable "$UUID" 2>/dev/null || true
    remove_from_enabled_list
    systemctl --user disable --now "$SERVICE" || true
    say "Stopped and disabled. The remote works as a plain keyboard and mouse again."
    ;;
status)
    systemctl --user --no-pager --lines=0 status "$SERVICE" || true
    if extension_listed; then gnome-extensions info "$UUID" | sed -n '1,/^$/p' | grep -E 'Name|State|Enabled|Version' || true
    else say "GNOME Shell does not know the extension yet (log out and in once after installing)."; fi
    ;;
*)
    say "usage: projecteur-setup enable | disable | status"
    exit 2
    ;;
esac
